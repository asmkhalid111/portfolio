# ==============================================================================
# Portfolio Environment Variables Template (.env.example)
# ==============================================================================
# This template is tracked in Git and contains ONLY sanitized placeholder values.
# Real credentials must NEVER be placed in this file.
#
# LOCAL SETUP:
# Copy this template to .env.local:
#   cp .env.example .env.local
# Then replace the placeholders with your actual Supabase project connection values.
#
# SECURITY INVARIANTS:
# 1. .env.local is private and strictly ignored by Git (.gitignore).
# 2. Publishable keys (NEXT_PUBLIC_*) are exposed to the browser; they provide
#    zero administrative privileges. Data access is governed strictly by
#    PostgreSQL Row Level Security (RLS) policies and SQL grants.
# 3. Privileged variables (e.g. SUPABASE_SECRET_KEY, SUPABASE_DB_PASSWORD)
#    are NOT used by the runtime application and must NEVER be placed in client
#    bundles or committed to version control.
# ==============================================================================

# Supabase Public Connection Variables (Required for M02)
# Obtain these from your Supabase Dashboard: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-placeholder

# ==============================================================================
# Privileged Tooling Variables (Documented for future offline/test reference only)
# DO NOT populate or commit these values during Gate B.
# ==============================================================================
# SUPABASE_SECRET_KEY=sb_secret_your-placeholder (Offline CLI/test tooling only)
# SUPABASE_DB_PASSWORD=your-db-password-placeholder (Direct psql/migration only)
