# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Next.js build
/.next/
/out/
/build

# Misc
.DS_Store
*.pem
*.key

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment secrets
.env*
.env*.local
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Supabase backup and snapshot files (Never commit database dumps)
supabase/backups/
*.dump
*.backup

# Explicitly ensure migrations and seeds are NEVER ignored
!supabase/migrations/*.sql
!supabase/seed.sql
